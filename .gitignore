# ==============================================================================
# Mini-ERP Project - Global .gitignore
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
jspm_packages/
web_modules/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
**/.env
**/.env.*
# Exclude env.example template if it exists
!*.env.example
!**/*.env.example

# Build & Compiled Output
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
*.tsbuildinfo
*.output/

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# IDEs, Editors & System Files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.DS_Store
Thumbs.db
desktop.ini

# AI tooling / agent configuration (local only, not part of the portfolio deliverable)
.claude/
.agents/
.opencode/
skills-lock.json
