# PostgreSQL connection strings
DATABASE_URL="postgresql://mini_erp:mini_erp@localhost:5432/mini_erp?schema=public"
DATABASE_URL_TEST="postgresql://mini_erp:mini_erp@localhost:5432/mini_erp_test?schema=public"

# Auth secrets (generate with: openssl rand -hex 32; mínimo 32 caracteres)
JWT_SECRET="change-me-change-me-change-me-min-32chars"
COOKIE_SECRET="change-me-change-me-change-me-min-32chars"

# Opcional: contraseña de las cuentas demo que crea `prisma/seed.ts`.
# Si no se define, usa un valor por defecto — no dejar ese default en un
# deploy real.
# SEED_PASSWORD="change-me"

# Server
PORT=3000
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:5173"
CLIENT_URL="http://localhost:5173"
